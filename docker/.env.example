# Copy to docker/.env and adjust. docker compose reads it automatically.
POSTGRES_USER=kala
POSTGRES_PASSWORD=change-me
POSTGRES_DB=kala

# Host port the app is published on
KALA_PORT=3000

# Required: the exact URL you open kala at in the browser (protocol + host + port).
# Form submissions from any other URL are rejected by SvelteKit's CSRF check.
#   plain:          http://homeserver:3000
#   reverse proxy:  https://kala.example.ts.net
ORIGIN=http://homeserver:3000

TZ=Europe/Berlin
